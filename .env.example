# Set to the final public origin before the production build (no trailing path).
# Railway's RAILWAY_PUBLIC_DOMAIN is also detected automatically.
# Without either variable, local previews remain noindex.
APP_URL=

# Optional analytics; leave empty to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_UI_HOST=
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
NEXT_PUBLIC_GTM_ID=

# Optional inherited component-registry tooling; not needed for the portfolio.
GITHUB_API_TOKEN=
NEXT_PUBLIC_SHOW_PORTFOLIO_REGISTRY_SECTIONS=
NEXT_PUBLIC_REGISTRY_NAMESPACE=
NEXT_PUBLIC_REGISTRY_NAMESPACE_URL=
